import { Button, LineEdit, ComboBox, CheckBox, TabWidget, Palette } from "std-widgets.slint";

export enum Action { save, pair, start, stop, quit, daily-report, monthly-report, periodic-report, resolve-report, acknowledge-orphaned-receipt }

component Hint inherits Text { color: #8c8c8c; font-size: 12px; wrap: word-wrap; }
component Heading inherits Text { font-size: 18px; font-weight: 600; color: #262626; }
component Card inherits Rectangle { background: white; border-width: 1px; border-color: #f0f0f0; border-radius: 8px; }

/// A read-only fact; assistive technology reads the label with its value.
component StatusRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> alert;
    spacing: 24px;
    Text { text: root.label; width: 180px; color: #595959; vertical-alignment: center; accessible-role: none; }
    Text { accessible-label: root.label; accessible-value: root.value; text: root.value; color: root.alert ? #cf1322 : #262626; font-weight: 600; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
}

export component AppWindow inherits Window {
    title: "Holuto Workshop";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1180px; preferred-height: 820px;
    min-width: 1040px; min-height: 720px;
    background: #f5f5f5;
    default-font-size: 14px;
    in-out property <int> tab;
    // Printers are plugged in while the app runs in the tray: re-enumerate on showing Ustawienia.
    changed tab => { if self.tab == 2 { root.refresh-ports(); } }
    in-out property <int> port-index;
    in property <bool> running;
    in property <bool> saving-settings;
    in property <bool> pairing;
    in property <bool> starting;
    private property <bool> settings-editable: !root.running && !root.saving-settings && !root.pairing;
    in property <bool> stopping;
    in property <bool> reports-enabled;
    in property <bool> daily-report-enabled;
    in property <bool> report-unresolved;
    in property <bool> orphaned-receipt;
    in property <string> holuto-text;
    in property <string> printer-text;
    in property <int> printer-tone;
    in property <string> status;
    // Stan: the model words every value; Slint only shows them.
    in property <string> processing-state;
    in property <string> holuto-state;
    in property <string> printer-identity;
    in property <string> printer-state;
    in property <string> start-hint;
    in-out property <string> pairing-code;
    in-out property <string> port;
    in property <[string]> ports;
    in property <[string]> baud-rates;
    in-out property <int> baud-index;
    in property <[string]> months;
    in-out property <int> month-index;
    in-out property <string> from-date;
    in-out property <string> to-date;
    in-out property <bool> summary;
    in-out property <bool> telemetry-enabled;
    callback telemetry-changed(bool);
    in-out property <bool> start-on-launch;
    callback autostart-changed(bool);
    callback refresh-ports();
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-action;
    in property <bool> confirming;
    callback action(Action);
    callback confirm(bool);
    init => { Palette.color-scheme = ColorScheme.light; }
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 60px; background: white;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px; padding-top: 14px; padding-bottom: 14px; spacing: 12px;
                Image { source: @image-url("../assets/icon.png"); width: 32px; height: 32px; vertical-stretch: 0; }
                VerticalLayout { alignment: center; Text { text: "Holuto Workshop"; font-size: 18px; font-weight: 700; color: #141414; } }
                Rectangle { horizontal-stretch: 1; }
                if root.holuto-text != "": VerticalLayout { spacing: 4px; Text { text: "Holuto"; color: #595959; font-size: 12px; accessible-role: none; } Text { accessible-label: "Holuto"; accessible-value: root.holuto-text; text: root.holuto-text; color: #595959; } }
                if root.printer-text != "": VerticalLayout { spacing: 4px; Text { text: "Drukarka"; color: #595959; font-size: 12px; accessible-role: none; } Text { accessible-label: "Drukarka"; accessible-value: root.printer-text; text: root.printer-text; color: root.printer-tone == 2 ? #cf1322 : #595959; } }
            }
        }
        VerticalLayout {
            padding-left: 28px; padding-right: 28px; padding-top: 16px; padding-bottom: 16px; spacing: 16px;
            TabWidget {
                current-index <=> root.tab;
                Tab {
                    title: "Stan";
                    VerticalLayout {
                        padding-top: 16px; spacing: 16px;
                        Card {
                            vertical-stretch: 0;
                            VerticalLayout {
                                padding: 24px; spacing: 16px; alignment: start;
                                StatusRow { label: "Obsługa drukarki"; value: root.processing-state; }
                                Rectangle { height: 1px; background: #f0f0f0; }
                                StatusRow { label: "Holuto"; value: root.holuto-state; }
                                Rectangle { height: 1px; background: #f0f0f0; }
                                StatusRow { label: "Drukarka"; value: root.printer-identity; }
                                Rectangle { height: 1px; background: #f0f0f0; }
                                StatusRow { label: "Stan drukarki"; value: root.printer-state; alert: root.printer-tone == 2; }
                                VerticalLayout {
                                    spacing: 4px;
                                    Hint { text: "Paragony wystawiasz i przeglądasz w Holuto. Zadania z kolejki Holuto drukują się tutaj automatycznie."; }
                                    if root.start-hint != "": Hint { text: root.start-hint; }
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Tab {
                    title: "Raporty";
                    VerticalLayout {
                        padding-top: 16px; spacing: 16px;
                        Card {
                            vertical-stretch: 0;
                            VerticalLayout {
                                padding: 24px; spacing: 20px; alignment: start;
                                HorizontalLayout { spacing: 24px; VerticalLayout { horizontal-stretch: 1; spacing: 8px; Heading { text: "Raport dobowy"; font-size: 16px; } Hint { text: "Po zakończeniu sprzedaży, najpóźniej przed pierwszą sprzedażą następnego dnia."; } } VerticalLayout { alignment: center; Button { width: 240px; text: "Drukuj raport dobowy"; enabled: root.daily-report-enabled; clicked => { root.action(Action.daily-report); } } } }
                                Rectangle { height: 1px; background: #f0f0f0; }
                                HorizontalLayout { spacing: 24px; VerticalLayout { horizontal-stretch: 1; spacing: 8px; Heading { text: "Raport miesięczny"; font-size: 16px; } Hint { text: "Po zakończeniu miesiąca, najpóźniej do 25. dnia następnego miesiąca."; } } VerticalLayout { alignment: center; ComboBox { model: root.months; current-index <=> root.month-index; width: 190px; } } VerticalLayout { alignment: center; Button { width: 240px; text: "Drukuj raport miesięczny"; enabled: root.reports-enabled; clicked => { root.action(Action.monthly-report); } } } }
                                Rectangle { height: 1px; background: #f0f0f0; }
                                VerticalLayout { spacing: 16px; Heading { text: "Raport okresowy"; font-size: 16px; } HorizontalLayout { spacing: 12px; Text { text: "Od"; vertical-alignment: center; } LineEdit { text <=> root.from-date; placeholder-text: "dd.mm.rrrr"; width: 130px; accessible-label: "Data początkowa"; } Text { text: "do"; vertical-alignment: center; } LineEdit { text <=> root.to-date; placeholder-text: "dd.mm.rrrr"; width: 130px; accessible-label: "Data końcowa"; } CheckBox { text: "Skrócony"; checked <=> root.summary; } Rectangle { horizontal-stretch: 1; } Button { width: 240px; text: "Drukuj raport okresowy"; enabled: root.reports-enabled; clicked => { root.action(Action.periodic-report); } } } }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Tab {
                    title: "Ustawienia";
                    VerticalLayout {
                        padding-top: 16px;
                        Card {
                            vertical-stretch: 0;
                            VerticalLayout {
                                padding: 24px; spacing: 14px; alignment: start;
                                VerticalLayout {
                                    spacing: 12px;
                                    HorizontalLayout { spacing: 12px; Text { text: "Kod parowania"; width: 140px; vertical-alignment: center; } LineEdit { accessible-label: "Kod parowania"; text <=> root.pairing-code; placeholder-text: "XXXX-XXXX"; enabled: root.settings-editable; } Button { text: "Sparuj"; accessible-label: "Sparuj"; enabled: root.settings-editable; clicked => { root.action(Action.pair); } } }
                                    HorizontalLayout { spacing: 12px; Text { text: "Port drukarki"; width: 140px; vertical-alignment: center; } ComboBox { accessible-label: "Port drukarki"; model: root.ports; current-index <=> root.port-index; enabled: root.settings-editable; selected(value) => { root.port = self.current-index == 0 ? "" : value; root.action(Action.save); } } }
                                    HorizontalLayout { spacing: 12px; Text { text: "Prędkość transmisji"; width: 140px; vertical-alignment: center; } ComboBox { accessible-label: "Prędkość transmisji"; model: root.baud-rates; current-index <=> root.baud-index; enabled: root.settings-editable; selected => { root.action(Action.save); } } }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    CheckBox { text: "Udostępniaj diagnostykę"; accessible-label: "Udostępniaj diagnostykę"; enabled: !root.pairing; checked <=> root.telemetry-enabled; toggled => { root.telemetry-changed(self.checked); } }
                                    Hint { text: "Wysyła błędy i logi, aby ułatwić naprawę aplikacji. Zrzuty awarii mogą zawierać dane wrażliwe. Wyłączenie działa od razu, a dla zrzutów awarii i przy włączaniu — po restarcie."; }
                                }
                                CheckBox { text: "Uruchamiaj przy logowaniu"; accessible-label: "Uruchamiaj przy logowaniu"; enabled: !root.pairing && !root.saving-settings; checked <=> root.start-on-launch; toggled => { root.autostart-changed(self.checked); } }
                                HorizontalLayout { spacing: 10px; Button { text: "Uruchom"; primary: true; enabled: !root.running && !root.pairing && !root.starting; clicked => { root.action(Action.start); } } Button { text: "Zatrzymaj"; enabled: (root.running || root.pairing) && !root.stopping; clicked => { root.action(Action.stop); } } Rectangle { horizontal-stretch: 1; } Button { text: "Zakończ"; clicked => { root.action(Action.quit); } } }
                                if root.running: Hint { text: "Aby zmienić ustawienia, najpierw zatrzymaj obsługę drukarki."; }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
            if root.status != "": HorizontalLayout {
                height: 36px; spacing: 16px;
                Text { accessible-label: "Stan operacji"; accessible-value: root.status; text: root.status; color: #cf1322; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                if root.report-unresolved: Button { text: "Wyjaśnij raport"; clicked => { root.action(Action.resolve-report); } }
                if root.orphaned-receipt: Button { text: "Wyjaśnij paragon"; accessible-label: "Wyjaśnij paragon"; clicked => { root.action(Action.acknowledge-orphaned-receipt); } }
            }
        }
    }
    if root.confirming: Rectangle {
        background: #00000055;
        TouchArea { }
        Card {
            width: 500px; height: dialog-layout.preferred-height;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            dialog-layout := VerticalLayout {
                padding: 28px; spacing: 24px;
                Heading { text: root.confirm-title; }
                Text { accessible-label: "Treść potwierdzenia"; accessible-value: root.confirm-text; text: root.confirm-text; wrap: word-wrap; color: #595959; }
                HorizontalLayout { alignment: end; spacing: 12px; Button { text: "Anuluj"; clicked => { root.confirm(false); } } Button { text: root.confirm-action; primary: true; clicked => { root.confirm(true); } } }
            }
        }
    }
}

export component TrayIcon inherits SystemTrayIcon {
    icon: @image-url("../assets/icon.png");
    tooltip: "Holuto Workshop";
    title: "Holuto Workshop";
    callback open;
    callback quit;
    clicked => { root.open(); }
    Menu { MenuItem { title: "Otwórz"; activated => { root.open(); } } MenuSeparator {} MenuItem { title: "Zakończ"; activated => { root.quit(); } } }
}

export component ErrorWindow inherits Window {
    title: "Holuto Workshop — błąd"; preferred-width: 520px; preferred-height: 240px; background: #f5f5f5;
    in property <string> message;
    callback dismiss;
    VerticalLayout { padding: 28px; spacing: 24px; Heading { text: "Nie można uruchomić aplikacji"; } Text { text: root.message; wrap: word-wrap; color: #cf1322; } Button { text: "Zamknij"; primary: true; clicked => { root.dismiss(); } } }
}
