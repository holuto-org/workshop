    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/agent/heartbeat": {
      "post": {
        "operationId": "agent_printer_heartbeat",
        "parameters": [
          {
            "name": "X-Device-Unique-Number",
            "in": "header",
            "description": "Fiscal memory unique number pinned by the printer's first session.",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "ABC1234567890"
              ],
              "maxLength": 13,
              "minLength": 13,
              "pattern": "^[A-Z]{3}[0-9]{10}$"
            }
          }
        ],
        "responses": {
          "204": {},
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "408": {
            "$ref": "#/components/responses/RequestTimeout"
          },
          "426": {
            "$ref": "#/components/responses/UpgradeRequired"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        },
        "security": [
          {
            "bearerToken": []
          }
        ]
      }
    },
