    "/openapi/{file}": {
      "get": {
        "operationId": "openapi_document_get",
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "description": "Audience document filename.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OpenApiFile"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "That audience's document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
