  "components": {
    "schemas": {
      "AgentJob": {
        "type": "object",
        "required": [
          "id",
          "printerId",
          "kind",
          "orderNumber",
          "allocationId",
          "companyName",
          "buyerNip",
          "lines",
          "advances",
          "payments",
          "total",
          "state",
          "attempt",
          "issuedAt",
          "receiptNumber",
          "result"
        ],
        "properties": {
          "advances": {
            "$ref": "#/components/schemas/CappedSet0To5_AdvanceDeduction"
          },
          "allocationId": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PaymentAllocationId"
              },
              {
                "type": "null"
              }
            ]
          },
          "attempt": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Attempt"
              },
              {
                "type": "null"
              }
            ]
          },
          "buyerNip": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Nip"
              },
              {
                "type": "null"
              }
            ]
          },
          "companyName": {
            "$ref": "#/components/schemas/Name"
          },
          "id": {
            "$ref": "#/components/schemas/FiscalJobId"
          },
          "issuedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The printer's issue time of the job's receipt."
          },
          "kind": {
            "$ref": "#/components/schemas/FiscalReceiptKind"
          },
          "lines": {
            "$ref": "#/components/schemas/Capped1To100000_ReceiptLine"
          },
          "orderNumber": {
            "$ref": "#/components/schemas/OrderNumber"
          },
          "payments": {
            "$ref": "#/components/schemas/CappedSet0To5_ReceiptPayment"
          },
          "printerId": {
            "$ref": "#/components/schemas/FiscalPrinterId"
          },
          "receiptNumber": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DeviceCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Note"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "$ref": "#/components/schemas/FiscalJobState"
          },
          "total": {
            "$ref": "#/components/schemas/PositiveAmount_Amount"
          }
        },
        "additionalProperties": false
      },
      "AgentPaired": {
        "type": "object",
        "required": [
          "token",
          "printerId"
        ],
        "properties": {
          "printerId": {
            "$ref": "#/components/schemas/FiscalPrinterId"
          },
          "token": {
            "$ref": "#/components/schemas/Token"
          }
        },
        "additionalProperties": false
      },
      "AgentPrinter": {
        "type": "object",
        "required": [
          "id",
          "uniqueNumber",
          "capabilities",
          "vatRates"
        ],
        "properties": {
          "capabilities": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PrinterCapabilities"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "$ref": "#/components/schemas/FiscalPrinterId"
          },
          "uniqueNumber": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UniqueNumber"
              },
              {
                "type": "null"
              }
            ]
          },
          "vatRates": {
            "$ref": "#/components/schemas/CappedSet0To7_VatRateMapping"
          }
        },
        "additionalProperties": false
      },
      "AgentSession": {
        "type": "object",
        "description": "What `POST /agent/session` answers: the identity, limits and VAT letters Holuto recorded.",
        "required": [
          "printer"
        ],
        "properties": {
          "printer": {
            "$ref": "#/components/schemas/AgentPrinter"
          }
        },
        "additionalProperties": false
      },
      "AllowedCharacters": {
        "type": "string",
        "description": "Every character the printer can print, including spaces, in Unicode NFC. No control characters.",
        "examples": [
          " ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-.,"
        ],
        "maxLength": 4194304,
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      },
      "Attempt": {
        "type": "string",
        "format": "uuid",
        "examples": [
          "01925d4f-a342-7a33-91fe-000000000001"
        ]
      },
      "CallerVary": {
        "type": "string",
        "enum": [
          "Authorization, Cookie, Accept-Language"
        ]
      },
      "Capped0To100_FieldError": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "pointer",
            "detail"
          ],
          "properties": {
            "code": {
              "$ref": "#/components/schemas/ErrorCode"
            },
            "detail": {
              "type": "string"
            },
            "pointer": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "maxItems": 100,
        "minItems": 0
      },
      "Capped0To70_VatRateMapping": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "letter",
            "vatRate"
          ],
          "properties": {
            "letter": {
              "$ref": "#/components/schemas/FiscalVatLetter"
            },
            "vatRate": {
              "$ref": "#/components/schemas/VatRate"
            }
          },
          "additionalProperties": false
        },
        "maxItems": 70,
        "minItems": 0
      },
      "Capped1To100000_ReceiptLine": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "quantity",
            "unitPrice",
            "total",
            "vatRate",
            "vatLetter"
          ],
          "properties": {
            "name": {
              "$ref": "#/components/schemas/Title"
            },
            "quantity": {
              "$ref": "#/components/schemas/PositiveQuantity_Quantity"
            },
            "total": {
              "$ref": "#/components/schemas/PositiveAmount_Amount"
            },
            "unitPrice": {
              "$ref": "#/components/schemas/PositiveUnitPrice_UnitPrice"
            },
            "vatLetter": {
              "$ref": "#/components/schemas/FiscalVatLetter"
            },
            "vatRate": {
              "$ref": "#/components/schemas/VatRate"
            }
          },
          "additionalProperties": false
        },
        "maxItems": 100000,
        "minItems": 1
      },
      "CappedSet0To5_AdvanceDeduction": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "vatLetter",
            "vatRate",
            "amount"
          ],
          "properties": {
            "amount": {
              "$ref": "#/components/schemas/PositiveAmount_Amount"
            },
            "vatLetter": {
              "$ref": "#/components/schemas/FiscalVatLetter"
            },
            "vatRate": {
              "$ref": "#/components/schemas/VatRate"
            }
          },
          "additionalProperties": false
        },
        "maxItems": 5,
        "minItems": 0,
        "uniqueItems": true
      },
      "CappedSet0To5_ReceiptPayment": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "form",
            "amount"
          ],
          "properties": {
            "amount": {
              "$ref": "#/components/schemas/PositiveAmount_Amount"
            },
            "form": {
              "$ref": "#/components/schemas/FiscalPaymentForm"
            }
          },
          "additionalProperties": false
        },
        "maxItems": 5,
        "minItems": 0,
        "uniqueItems": true
      },
      "CappedSet0To7_VatRateMapping": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "letter",
            "vatRate"
          ],
          "properties": {
            "letter": {
              "$ref": "#/components/schemas/FiscalVatLetter"
            },
            "vatRate": {
              "$ref": "#/components/schemas/VatRate"
            }
          },
          "additionalProperties": false
        },
        "maxItems": 7,
        "minItems": 0,
        "uniqueItems": true
      },
      "ClientLimits": {
        "type": "object",
        "required": [
          "maxPageSize",
          "maxFilesPerTarget",
          "maxFileBytesByMimeType",
          "downloadUrlValiditySeconds",
          "photoMaxEdge",
          "photoJpegQualityPercent",
          "previewMaxEdge",
          "previewMaxBytes",
          "previewJpegQualityPercent",
          "videoMaxEdge",
          "videoBitsPerSecond"
        ],
        "properties": {
          "downloadUrlValiditySeconds": {
            "$ref": "#/components/schemas/ProductConstant300"
          },
          "maxFileBytesByMimeType": {
            "$ref": "#/components/schemas/FileByteLimits"
          },
          "maxFilesPerTarget": {
            "$ref": "#/components/schemas/FileCountLimit"
          },
          "maxPageSize": {
            "$ref": "#/components/schemas/PageSize"
          },
          "photoJpegQualityPercent": {
            "$ref": "#/components/schemas/ProductConstant85"
          },
          "photoMaxEdge": {
            "$ref": "#/components/schemas/ProductConstant2560"
          },
          "previewJpegQualityPercent": {
            "$ref": "#/components/schemas/ProductConstant80"
          },
          "previewMaxBytes": {
            "$ref": "#/components/schemas/ProductConstant262144"
          },
          "previewMaxEdge": {
            "$ref": "#/components/schemas/ProductConstant512"
          },
          "videoBitsPerSecond": {
            "$ref": "#/components/schemas/ProductConstant6000000"
          },
          "videoMaxEdge": {
            "$ref": "#/components/schemas/ProductConstant1920"
          }
        },
        "additionalProperties": false
      },
      "Cursor": {
        "type": "string",
        "description": "Authenticated opaque continuation token, bounded on both input and production.",
        "maxLength": 16384,
        "minLength": 38
      },
      "CursorQuery": {
        "type": "object",
        "properties": {
          "cursor": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Cursor",
                "description": "Opaque: pass a page's `nextCursor` or `previousCursor` unchanged."
              },
              {
                "type": "null"
              }
            ]
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "default": 50,
            "maximum": 100,
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "DeviceCode": {
        "type": "string",
        "examples": [
          "Example"
        ],
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      },
      "DeviceCodeInput": {
        "type": "string",
        "examples": [
          "Example"
        ],
        "maxLength": 64,
        "minLength": 1
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable machine-readable message identifier, independent of localized wording.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      },
      "Etag": {
        "type": "string",
        "maxLength": 32,
        "minLength": 32,
        "pattern": "^[0-9a-f]{32}$"
      },
      "EtagHeader": {
        "type": "string",
        "maxLength": 36,
        "minLength": 34,
        "pattern": "^(W/)?\"[0-9a-f]{32}\"$"
      },
      "FieldError": {
        "type": "object",
        "required": [
