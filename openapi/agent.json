        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "QuantityDecimals": {
        "type": "integer",
        "examples": [
          3
        ],
        "maximum": 8,
        "minimum": 0
      },
      "ReceiptLine": {
        "type": "object",
        "required": [
          "name",
          "quantity",
          "unitPrice",
          "total",
          "vatRate",
          "vatLetter"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/Title"
          },
          "quantity": {
            "$ref": "#/components/schemas/PositiveQuantity_Quantity"
          },
          "total": {
            "$ref": "#/components/schemas/PositiveAmount_Amount"
          },
          "unitPrice": {
            "$ref": "#/components/schemas/PositiveUnitPrice_UnitPrice"
          },
          "vatLetter": {
            "$ref": "#/components/schemas/FiscalVatLetter"
          },
          "vatRate": {
            "$ref": "#/components/schemas/VatRate"
          }
        },
        "additionalProperties": false
      },
      "ReceiptPayment": {
        "type": "object",
        "required": [
          "form",
          "amount"
        ],
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/PositiveAmount_Amount"
          },
          "form": {
            "$ref": "#/components/schemas/FiscalPaymentForm"
          }
        },
        "additionalProperties": false
      },
      "ResultForm": {
        "type": "object",
        "required": [
          "attempt",
          "state"
        ],
        "properties": {
          "attempt": {
            "$ref": "#/components/schemas/Attempt"
          },
          "issuedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "receiptNumber": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Code"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Note"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "$ref": "#/components/schemas/Outcome"
          }
        },
        "additionalProperties": false
      },
      "Telemetry": {
        "type": "object",
        "required": [
          "vendor",
          "capabilities",
          "uniqueNumber",
          "model",
          "firmware",
          "appVersion",
          "vatRates"
        ],
        "properties": {
          "appVersion": {
            "$ref": "#/components/schemas/Code"
          },
          "capabilities": {
            "$ref": "#/components/schemas/PrinterCapabilities"
          },
          "firmware": {
            "$ref": "#/components/schemas/Code"
          },
          "model": {
            "$ref": "#/components/schemas/Code"
          },
          "uniqueNumber": {
            "$ref": "#/components/schemas/UniqueNumber"
          },
          "vatRates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VatRateMapping"
            }
          },
          "vendor": {
            "$ref": "#/components/schemas/FiscalVendor"
          }
        },
        "additionalProperties": false
      },
      "Title": {
        "type": "string",
        "examples": [
          "Example"
        ],
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      },
      "Token_TokenKindAgent": {
        "type": "string",
        "examples": [
          "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
        ],
        "writeOnly": true,
        "maxLength": 43,
        "minLength": 43,
        "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
      },
      "UniqueNumber": {
        "type": "string",
        "examples": [
          "ABC1234567890"
        ],
        "pattern": "^[A-Z]{3}[0-9]{10}$"
      },
      "VatRate": {
        "type": "string",
        "description": "Polish VAT rates as `KSeF` codes them; `zw` marks an exempt supply.",
        "enum": [
          "23",
          "8",
          "5",
          "0",
          "zw"
        ]
      },
      "VatRateMapping": {
        "type": "object",
        "required": [
          "letter",
          "vatRate"
        ],
        "properties": {
          "letter": {
            "$ref": "#/components/schemas/FiscalVatLetter"
          },
          "vatRate": {
            "$ref": "#/components/schemas/VatRate"
          }
        },
        "additionalProperties": false
      }
    },
