{
  "openapi": "3.1.0",
  "info": {
    "title": "Holuto agent API",
    "description": "",
    "license": {
      "name": "LicenseRef-Proprietary",
      "identifier": "LicenseRef-Proprietary"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/agent/heartbeat": {
      "post": {
        "operationId": "agent_printer_heartbeat",
        "parameters": [
          {
            "name": "X-Device-Unique-Number",
            "in": "header",
            "description": "Fiscal memory unique number pinned by the printer's first session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {},
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "408": {
            "$ref": "#/components/responses/RequestTimeout"
          },
          "426": {
            "$ref": "#/components/responses/UpgradeRequired"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        },
        "security": [
          {
            "bearerToken": []
          }
        ]
      }
    },
    "/agent/jobs/take": {
      "post": {
        "operationId": "agent_job_take",
        "parameters": [
          {
            "name": "X-Device-Unique-Number",
            "in": "header",
            "description": "Fiscal memory unique number pinned by the printer's first session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentJob"
                }
              }
            }
          },
          "204": {},
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "408": {
            "$ref": "#/components/responses/RequestTimeout"
          },
          "426": {
            "$ref": "#/components/responses/UpgradeRequired"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        },
        "security": [
          {
            "bearerToken": []
          }
        ]
      }
    },
    "/agent/jobs/{jobId}": {
      "get": {
        "operationId": "agent_job_get",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "description": "Fiscal job ID",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FiscalJobId"
            }
          },
          {
            "name": "X-Device-Unique-Number",
            "in": "header",
            "description": "Fiscal memory unique number pinned by the printer's first session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentJob"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "408": {
            "$ref": "#/components/responses/RequestTimeout"
          },
          "426": {
            "$ref": "#/components/responses/UpgradeRequired"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        },
        "security": [
          {
            "bearerToken": []
          }
        ]
      }
    },
    "/agent/jobs/{jobId}/result": {
      "post": {
        "operationId": "agent_job_result_report",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "description": "Fiscal job ID",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FiscalJobId"
            }
          },
          {
            "name": "X-Device-Unique-Number",
            "in": "header",
            "description": "Fiscal memory unique number pinned by the printer's first session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResultForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentJob"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "408": {
            "$ref": "#/components/responses/RequestTimeout"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "426": {
            "$ref": "#/components/responses/UpgradeRequired"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        },
        "security": [
          {
            "bearerToken": []
          }
        ]
      }
    },
    "/agent/pair": {
      "post": {
        "summary": "Redeem a human pairing proof once. Existing device authority is revoked only on success.",
        "operationId": "agent_printer_pair",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentPaired"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "408": {
            "$ref": "#/components/responses/RequestTimeout"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "426": {
            "$ref": "#/components/responses/UpgradeRequired"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/agent/session": {
      "post": {
        "operationId": "agent_session_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Telemetry"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSession"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "408": {
            "$ref": "#/components/responses/RequestTimeout"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "426": {
            "$ref": "#/components/responses/UpgradeRequired"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        },
        "security": [
          {
            "bearerToken": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "408": {
            "$ref": "#/components/responses/RequestTimeout"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/openapi/{file}": {
      "get": {
        "operationId": "openapi_document_get",
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "description": "`<audience>.json`",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "That audience's document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "408": {
            "$ref": "#/components/responses/RequestTimeout"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "readiness_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "408": {
            "$ref": "#/components/responses/RequestTimeout"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdvanceDeduction": {
        "type": "object",
        "required": [
          "vatLetter",
          "vatRate",
          "amount"
        ],
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/PositiveAmount_Amount"
          },
          "vatLetter": {
            "$ref": "#/components/schemas/FiscalVatLetter"
          },
          "vatRate": {
            "$ref": "#/components/schemas/VatRate"
          }
        },
        "additionalProperties": false
      },
      "AgentJob": {
        "type": "object",
        "required": [
          "id",
          "printerId",
          "kind",
          "orderNumber",
          "allocationId",
          "companyName",
          "buyerNip",
          "lines",
          "advances",
          "payments",
          "total",
          "state",
          "attempt",
          "issuedAt",
          "receiptNumber",
          "result"
        ],
        "properties": {
          "advances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdvanceDeduction"
            }
          },
          "allocationId": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PaymentAllocationId"
              },
              {
                "type": "null"
              }
            ]
          },
          "attempt": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Attempt"
              },
              {
                "type": "null"
              }
            ]
          },
          "buyerNip": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Nip"
              },
              {
                "type": "null"
              }
            ]
          },
          "companyName": {
            "$ref": "#/components/schemas/Name"
          },
          "id": {
            "$ref": "#/components/schemas/FiscalJobId"
          },
          "issuedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The printer's issue time of the job's receipt."
          },
          "kind": {
            "$ref": "#/components/schemas/FiscalReceiptKind"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceiptLine"
            }
          },
          "orderNumber": {
            "type": "integer",
            "format": "int64"
          },
          "payments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceiptPayment"
            }
          },
          "printerId": {
            "$ref": "#/components/schemas/FiscalPrinterId"
          },
          "receiptNumber": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Code"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Note"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "$ref": "#/components/schemas/FiscalJobState"
          },
          "total": {
            "$ref": "#/components/schemas/PositiveAmount_Amount"
          }
        },
        "additionalProperties": false
      },
      "AgentPaired": {
        "type": "object",
        "required": [
          "token",
          "printerId"
        ],
        "properties": {
          "printerId": {
            "$ref": "#/components/schemas/FiscalPrinterId"
          },
          "token": {
            "$ref": "#/components/schemas/Token_TokenKindAgent"
          }
        },
        "additionalProperties": false
      },
      "AgentPrinter": {
        "type": "object",
        "required": [
          "id",
          "uniqueNumber",
          "capabilities",
          "vatRates"
        ],
        "properties": {
          "capabilities": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PrinterCapabilities"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "$ref": "#/components/schemas/FiscalPrinterId"
          },
          "uniqueNumber": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UniqueNumber"
              },
              {
                "type": "null"
              }
            ]
          },
          "vatRates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VatRateMapping"
            }
          }
        },
        "additionalProperties": false
      },
      "AgentSession": {
        "type": "object",
        "description": "What `POST /agent/session` answers: the identity, limits and VAT letters Holuto recorded.",
        "required": [
          "printer"
        ],
        "properties": {
          "printer": {
            "$ref": "#/components/schemas/AgentPrinter"
          }
        },
        "additionalProperties": false
      },
      "AllowedCharacters": {
        "type": "string",
        "description": "Every character the printer can print, including spaces, in Unicode NFC. No control characters.",
        "examples": [
          " ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-.,"
        ],
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      },
      "Attempt": {
        "type": "string",
        "format": "uuid",
        "examples": [
          "01925d4f-a342-7a33-91fe-000000000001"
        ]
      },
      "ClientLimits": {
        "type": "object",
        "required": [
          "maxPageSize",
          "maxFilesPerTarget",
          "maxFileBytesByMimeType",
          "downloadUrlValiditySeconds",
          "photoMaxEdge",
          "photoJpegQualityPercent",
          "previewMaxEdge",
          "previewMaxBytes",
          "previewJpegQualityPercent",
          "videoMaxEdge",
          "videoBitsPerSecond"
        ],
        "properties": {
          "downloadUrlValiditySeconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "maxFileBytesByMimeType": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "propertyNames": {
              "type": "string",
              "enum": [
                "application/pdf",
                "image/jpeg",
                "video/mp4"
              ]
            }
          },
          "maxFilesPerTarget": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "maxPageSize": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "photoJpegQualityPercent": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "photoMaxEdge": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "previewJpegQualityPercent": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "previewMaxBytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "previewMaxEdge": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "videoBitsPerSecond": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "videoMaxEdge": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Code": {
        "type": "string",
        "examples": [
          "Example"
        ],
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      },
      "CursorQuery": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque: pass a page's `nextCursor` or `previousCursor` unchanged."
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "default": 50,
            "maximum": 100,
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "Etag": {
        "type": "string",
        "maxLength": 32,
        "minLength": 32,
        "pattern": "^[0-9a-f]{32}$"
      },
      "FieldError": {
        "type": "object",
        "required": [
          "code",
          "pointer",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "pointer": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "FiscalJobId": {
        "type": "string",
        "format": "uuid",
        "examples": [
          "0199aabc-1234-7000-8000-000000000001"
        ]
      },
      "FiscalJobState": {
        "type": "string",
        "enum": [
          "queued",
          "taken",
          "done",
          "failed",
          "expired",
          "unknown",
          "voided"
        ]
      },
      "FiscalPaymentForm": {
        "type": "string",
        "enum": [
          "cash",
          "card",
          "transfer",
          "mobile",
          "credit"
        ]
      },
      "FiscalPrinterId": {
        "type": "string",
        "format": "uuid",
        "examples": [
          "0199aabc-1234-7000-8000-000000000001"
        ]
      },
      "FiscalReceiptKind": {
        "type": "string",
        "enum": [
          "advance",
          "sale"
        ]
      },
      "FiscalVatLetter": {
        "type": "string",
        "enum": [
          "A",
          "B",
          "C",
          "D",
          "E",
          "F",
          "G"
        ]
      },
      "FiscalVendor": {
        "type": "string",
        "enum": [
          "posnet",
          "novitus",
          "elzab"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Language": {
        "type": "string",
        "enum": [
          "en",
          "pl",
          "es",
          "ru"
        ]
      },
      "Name": {
        "type": "string",
        "examples": [
          "Example"
        ],
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      },
      "Nip": {
        "type": "string",
        "description": "Normalized on input; responses always match `^[1-9]((\\d[1-9])|([1-9]\\d))\\d{7}$`.",
        "examples": [
          "5260250274"
        ],
        "minLength": 1
      },
      "Note": {
        "type": "string",
        "examples": [
          "Example"
        ],
        "maxLength": 2000,
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]+$"
      },
      "Outcome": {
        "type": "string",
        "enum": [
          "done",
          "failed",
          "unknown"
        ]
      },
      "PairForm": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/PairingInput"
          }
        },
        "additionalProperties": false
      },
      "PairingInput": {
        "type": "string",
        "description": "Retain malformed submitted proofs privately so all string proofs get the same refusal.",
        "example": "ABCD-2345"
      },
      "PaymentAllocationId": {
        "type": "string",
        "format": "uuid",
        "examples": [
          "0199aabc-1234-7000-8000-000000000001"
        ]
      },
      "PositiveAmount_Amount": {
        "type": "string",
        "format": "decimal",
        "description": "Money with at most two decimals.",
        "examples": [
          "1234.50"
        ],
        "pattern": "^(?!0(?:\\.0+)?$)[0-9]{1,16}(\\.[0-9]{1,2})?$"
      },
      "PositiveQuantity_Quantity": {
        "type": "string",
        "format": "decimal",
        "description": "Quantity with up to six decimals.",
        "examples": [
          "1.5"
        ],
        "pattern": "^(?!0(?:\\.0+)?$)[0-9]{1,16}(\\.[0-9]{1,6})?$"
      },
      "PositiveUnitPrice_UnitPrice": {
        "type": "string",
        "format": "decimal",
        "description": "Non-negative unit price with up to eight decimals.",
        "examples": [
          "11.27725962"
        ],
        "pattern": "^(?!0(?:\\.0+)?$)[0-9]{1,14}(\\.[0-9]{1,8})?$"
      },
      "PrinterCapabilities": {
        "type": "object",
        "required": [
          "maxItemNameLength",
          "maxCompanyNameLength",
          "maxLinesPerReceipt",
          "allowedCharacters",
          "maxQuantityDecimals",
          "advanceDeductions",
          "zeroTotalReceipts"
        ],
        "properties": {
          "advanceDeductions": {
            "type": "boolean"
          },
          "allowedCharacters": {
            "$ref": "#/components/schemas/AllowedCharacters"
          },
          "maxCompanyNameLength": {
            "$ref": "#/components/schemas/PrinterLimit"
          },
          "maxItemNameLength": {
            "$ref": "#/components/schemas/PrinterLimit"
          },
          "maxLinesPerReceipt": {
            "$ref": "#/components/schemas/PrinterLimit"
          },
          "maxQuantityDecimals": {
            "$ref": "#/components/schemas/QuantityDecimals"
          },
          "zeroTotalReceipts": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PrinterLimit": {
        "type": "integer",
        "examples": [
          42
        ],
        "maximum": 2147483647,
        "minimum": 1
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
